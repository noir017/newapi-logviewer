# Copy to .env and adjust. Only NEWAPI_LOG_DIR is required.

# Directory where new-api writes its *.log files (the LOG_DIR new-api uses).
NEWAPI_LOG_DIR=/path/to/new-api/logs

# Must match the timezone new-api logs in. Log lines carry no UTC offset, so a
# mismatch shifts every timestamp and breaks the time-range filter.
TZ=UTC

# Host port for the viewer.
LOGVIEWER_PORT=7071

# How the viewer reaches new-api (only used when AUTH_MODE=bearer).
NEWAPI_URL=http://new-api:3000

# URL prefix the viewer is mounted at. Use / when serving at the domain root.
BASE_PATH=/logviewer

# none | bearer   -- see README "Authentication"
AUTH_MODE=none

# When AUTH_MODE=bearer, also require role >= 100 (new-api admin).
REQUIRE_ADMIN=true

# Per-file tail bound in MB. Only the last N MB of each log file is parsed.
LIMIT_MB=40

# Seconds between disk-change checks.
CACHE_TTL=3

# --- Several pods, one archive (optional) ------------------------------------
# One new-api cluster running as several pods writes one DEBUG log per pod, so
# each viewer sees only its own share of the traffic. Setting these makes one pod
# the only archive writer and the others push their folded records to it. Leave
# them unset for a single-machine install. See README "Several pods, one archive".

# Which pod this is. Defaults to the hostname. Provenance only.
#POD_NAME=oracle

# Shared secret, the same value on every pod. On the ARCHIVING pod this is what
# enables the receiving endpoint at all - unset, it refuses every push. Put a
# real random value here (e.g. `openssl rand -base64 24`), not this placeholder.
#PUSH_TOKEN=

# Set on every pod EXCEPT the archiving one: where to push. Either the viewer's
# mount root or the endpoint itself.
#PUSH_URL=https://newapi-primary.example/logviewer

# Archiving pod, optional: only accept pushes from these POD_NAMEs.
#PUSH_PODS=oracle
